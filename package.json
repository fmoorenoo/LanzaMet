{
  "name": "lanzamet",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:demo": "ng serve --configuration demo",
    "api": "node server/dev.ts",
    "build": "ng build",
    "build:prod": "node scripts/build-production.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "node --test server/aemet.test.ts server/api.test.ts server/open-meteo.test.ts",
    "typecheck:api": "tsc -p server/tsconfig.json",
    "verify:sources": "node scripts/verify-sources.ts",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"server/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"server/*.ts\"",
    "preview": "node scripts/build-production.ts --allow-without-feedback && wrangler dev --port 8788",
    "deploy": "node scripts/build-production.ts && wrangler deploy",
    "deploy:check": "node scripts/build-production.ts --allow-without-feedback && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "lucide": "1.52.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24"
  }
}
